# ProofInvoice configuration. Copy to .env — never commit .env.
# Variable names follow the official @vlayer/sdk config schema (docs/vlayer-version.md).

# demo -> parser + UI + metrics only. Proving/verification endpoints fail loudly (HTTP 409).
# live -> real vlayer Email Proofs and on-chain verification. Requires the values below.
PROOFINVOICE_MODE=demo

# vlayer prover API endpoint (official env var name).
#   local devnet: http://127.0.0.1:3000 (call_server container, see contracts/compose.yaml)
#   hosted testnet: https://stable-fake-prover.vlayer.xyz/1.5.1/
PROVER_URL=http://127.0.0.1:3000

# vlayer DNS resolver used for DKIM lookups during email preverification (official name).
#   local devnet: http://127.0.0.1:3002 (vdns_server container)
#   hosted testnet: https://test-dns.vlayer.xyz
DNS_SERVICE_URL=http://127.0.0.1:3002

# vlayer API token from https://dashboard.vlayer.xyz/ (required by hosted environments).
VLAYER_API_TOKEN=

# vlayer environment selector (official name): dev | testnet | mainnet.
VLAYER_ENV=dev

# Settlement chain. Single source of truth: the chain id sent with the proving request
# is derived from it in src/vlayer/chains.ts. Supported values:
#   anvil | sepolia | base-sepolia | optimism-sepolia | arbitrum-sepolia
CHAIN_NAME=anvil

# EVM JSON-RPC endpoint the app sends the verification tx to.
JSON_RPC_URL=http://127.0.0.1:8545

# Deployed contract addresses (output of `forge script script/Deploy.s.sol`).
PROVER_ADDRESS=
VERIFIER_ADDRESS=
REGISTRY_ADDRESS=

# Account paying for the verification tx. For local devnet use a default anvil key.
# For testnet, use a dedicated wallet holding testnet ETH only.
# NEVER put a real key in this file or in git — .env is git-ignored.
PRIVATE_KEY=

# HTTP port for the UI and API.
PORT=3000
