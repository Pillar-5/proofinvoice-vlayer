# ProofInvoice configuration. Copy to .env — never commit .env.
# Every variable is documented in README.md#configuration.

# demo  -> parser + UI + metrics only. Proving/verification endpoints fail loudly (HTTP 409).
# live  -> real vlayer Email Proofs and on-chain verification. Requires the values below.
PROOFINVOICE_MODE=demo

# vlayer prover API endpoint (official vlayer env var name).
# Local devnet: the call_server container from contracts/compose.yaml. Hosted: see docs.vlayer.xyz.
PROVER_URL=http://127.0.0.1:3000

# vlayer DNS resolver used during email preverification (official name).
# Local devnet: vdns_server container. Hosted: https://test-dns.vlayer.xyz
DNS_SERVICE_URL=http://127.0.0.1:3002

# vlayer API token. Required only for hosted (non-devnet) prover environments.
VLAYER_API_TOKEN=

# vlayer environment selector (official name): dev | testnet | mainnet.
VLAYER_ENV=dev

# Settlement chain. This is the single source of truth: the chain id sent with the
# proving request is derived from it in src/vlayer/chains.ts. Supported values mirror
# contracts/foundry.toml [rpc_endpoints]:
#   anvil | sepolia | base-sepolia | optimism-sepolia | arbitrum-sepolia
CHAIN_NAME=anvil

# EVM JSON-RPC endpoint the app sends the verification tx to.
JSON_RPC_URL=http://127.0.0.1:8545

# Deployed contract addresses (output of `forge script Deploy` / npm run deploy:local).
PROVER_ADDRESS=
VERIFIER_ADDRESS=
REGISTRY_ADDRESS=

# Account paying for the verification tx. For local devnet use a default anvil key.
# NEVER put a real key in this file or in git.
PRIVATE_KEY=

# HTTP port for the demo UI and API.
PORT=3000
