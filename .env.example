# ProofInvoice configuration. Copy to .env — never commit .env.
# Every variable is documented in README.md#configuration.

# demo  -> parser + UI + metrics only. Proving/verification endpoints fail loudly (HTTP 409).
# live  -> real vlayer Email Proofs and on-chain verification. Requires the values below.
PROOFINVOICE_MODE=demo

# vlayer prover API endpoint. For local devnet this is the call_server docker container.
VLAYER_URL=http://127.0.0.1:3000

# vlayer DNS resolver used during email preverification (vdns_server docker container locally,
# or the public https://test-dns.vlayer.xyz for hosted proving).
DNS_SERVICE_URL=http://127.0.0.1:3002

# vlayer API token. Required only for hosted (non-devnet) prover environments.
VLAYER_API_TOKEN=

# Chain the proof is settled on. Currently supported: anvil | sepolia | base-sepolia |
# optimism-sepolia | arbitrum-sepolia (mirrors contracts/foundry.toml [rpc_endpoints]).
CHAIN_NAME=anvil

# Chain id submitted with the proving request (vlayer devnet is 31337).
CHAIN_ID=31337

# EVM JSON-RPC endpoint the app sends the verification tx to.
JSON_RPC_URL=http://127.0.0.1:8545

# Deployed contract addresses (output of `forge script Deploy` / npm run deploy:local).
PROVER_ADDRESS=
VERIFIER_ADDRESS=
REGISTRY_ADDRESS=

# Account paying for the verification tx. For local devnet use a default anvil key.
# NEVER put a real key in this file or in git.
PRIVATE_KEY=

# HTTP port for the demo UI and API.
PORT=3000
